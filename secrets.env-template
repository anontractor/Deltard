# Copy to secrets.env and fill in. secrets.env is gitignored — never commit it.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# RSA token: prefix (PIN) / postfix wrapped around the 6-digit code read from
# the webcam. Leave blank if the site takes the bare 6-digit tokencode.
TOKEN_PREFIX=
TOKEN_POSTFIX=

# Notifications. For channel: ntfy — pick a long random topic (anyone who
# knows it can read your alerts), then subscribe to it in the ntfy phone app.
NTFY_TOPIC=

# For channel: email — Gmail requires an App Password here, not your password.
SMTP_USER=
SMTP_PASSWORD=

# Optional dead-man's switch ping URL (e.g. https://hc-ping.com/<uuid>).
HEALTHCHECK_URL=
